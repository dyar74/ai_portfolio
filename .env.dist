# ============================================================
# Baked default environment (committed, NO secrets).
#
# This file is copied into the prod image as `.env` (see
# docker/php/Dockerfile, `prod` stage) so that Symfony's runtime
# can boot `bin/console` / the app inside the container (there is
# no bind mount in prod).
#
# At RUNTIME, real values are injected by Docker Compose via the
# `environment:` block in docker-compose.prod.yml — and Symfony
# Dotenv does NOT override variables that are already set in the
# process environment. So the real secrets (APP_SECRET,
# DATABASE_URL, REDIS_URL, ...) always come from Compose, not here.
#
# DESIGN (matches .env.example / the host .env):
#   - credentials are PARTS (MYSQL_USER, MYSQL_PASSWORD, ...)
#   - the DSNs (DATABASE_URL, REDIS_URL, MESSENGER_TRANSPORT_DSN)
#     are DERIVED from those parts:
#       * `make init` derives them for the host .env
#       * docker-compose.prod.yml re-derives the same DSNs and
#         injects them into the container (empty here, so Compose wins)
#
# Keep this file secret-free. For local dev, copy .env.example to
# .env and run `make init` (that file is git-ignored and not baked).
# ============================================================

# --- Server / runtime ---
HTTP_PORT=8080
APP_VERSION=latest

# --- Runtime (prod defaults; Compose sets the same for the app) ---
APP_ENV=prod
APP_DEBUG=0

# --- MySQL 8.4 (utf8mb4) — parts; DATABASE_URL is derived from these ---
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Symfony ---
APP_SECRET=

# --- DSNs (DERIVED from the parts above; empty here, Compose injects them) ---
DATABASE_URL=
REDIS_URL=
MESSENGER_TRANSPORT_DSN=

# --- Mailer (required for prod; Compose injects the real value) ---
MAILER_DSN=

# --- n8n (non-secret base URL; secrets come from Compose) ---
N8N_BASE_URL=https://n8n.novotek.com.ua
N8N_WEBHOOK_SECRET=
N8N_HMAC_KEY=
N8N_API_KEY=

# --- Optional / feature-flagged (empty unless enabled) ---
TURNSTILE_SECRET=
CONTACT_TO_EMAIL=

# Only set when running behind a reverse proxy with nginx real_ip enabled
TRUSTED_PROXIES=
