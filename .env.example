# ============================================
# Application Environment Variables
# ============================================

# Runtime
APP_ENV=dev
APP_DEBUG=1

# Secret (generate with: openssl rand -hex 32)
APP_SECRET=change_me_in_production

# Database (MySQL 8.4, utf8mb4)
# Format: mysql://user:pass@host:3306/dbname?serverVersion=8.4&charset=utf8mb4
DATABASE_URL=mysql://portfolio:CHANGE_ME@mysql:3306/portfolio?serverVersion=8.4&charset=utf8mb4

# Redis (password-protected)
# Format: redis://:password@host:6379
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Messenger transport (Redis)
# Format: redis://:password@host:6379/queue_name
MESSENGER_TRANSPORT_DSN=redis://:CHANGE_ME@redis:6379/messages

# Mailer (SMTP)
# Dev: Mailpit at mailpit:1025
# Prod: your SMTP provider
MAILER_DSN=smtp://mailpit:1025

# n8n instance
N8N_BASE_URL=https://n8n.novotek.com.ua
# N8N_WEBHOOK_SECRET / N8N_HMAC_KEY / N8N_API_KEY are OPTIONAL (empty by default)



# Cloudflare Turnstile (optional, feature-flagged)
TURNSTILE_SECRET=

# Contact email for lead notifications
CONTACT_TO_EMAIL=

# Trusted proxies (comma-separated, empty by default)
# Only set if running behind a reverse proxy with nginx real_ip enabled
TRUSTED_PROXIES=
