# ============================================================
# Environment template — copy to `.env` and run `make init`.
# Single source of truth for BOTH dev (docker-compose.yml) and
# prod (docker-compose.prod.yml). Compose auto-loads `.env` from
# the repo-root working directory (no --env-file needed).
#
# DESIGN: credentials are stored as PARTS (MYSQL_USER,
# MYSQL_PASSWORD, ...). The DSNs (DATABASE_URL, REDIS_URL,
# MESSENGER_TRANSPORT_DSN) are DERIVED from those parts:
#   - `make init` derives them for the host `.env`
#   - docker-compose.prod.yml re-derives the same DSNs and
#     injects them into the container (the baked .env.dist has
#     them empty, so Compose's values always win)
# Keep MySQL/Redis passwords [A-Za-z0-9] only (interpolated into DSNs).
# ============================================================

# --- Server / runtime ---
HTTP_PORT=8080
APP_VERSION=latest
XDEBUG_MODE=off

# --- MySQL 8.4 (utf8mb4) — parts; DATABASE_URL is derived from these ---
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- Redis — REDIS_URL / MESSENGER_TRANSPORT_DSN are derived from this ---
REDIS_PASSWORD=CHANGE_ME

# --- Symfony ---
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_production

# --- DSNs (DERIVED from the parts above; `make init` fills these) ---
# Format: mysql://user:pass@host:3306/db?serverVersion=8.4&charset=utf8mb4
DATABASE_URL=mysql://portfolio:CHANGE_ME@mysql:3306/portfolio?serverVersion=8.4&charset=utf8mb4
# Format: redis://:pass@host:6379
REDIS_URL=redis://:CHANGE_ME@redis:6379
# Format: redis://:pass@host:6379/queue
MESSENGER_TRANSPORT_DSN=redis://:CHANGE_ME@redis:6379/messages

# --- Mailer (dev: Mailpit; prod: your SMTP provider) ---
MAILER_DSN=smtp://mailpit:1025

# --- n8n (dev: local n8n on the host; prod: Compose injects the real URL) ---
# Dev compose adds host.docker.internal:host-gateway, so this resolves to the
# host's n8n container. Override in .env if your local n8n is elsewhere.
N8N_BASE_URL=http://host.docker.internal:5678
# N8N_WEBHOOK_SECRET / N8N_HMAC_KEY / N8N_API_KEY are OPTIONAL (empty by default)
N8N_WEBHOOK_SECRET=
N8N_HMAC_KEY=
N8N_API_KEY=

# --- Optional / feature-flagged ---
TURNSTILE_SECRET=
CONTACT_TO_EMAIL=
# Trusted proxies (comma-separated). Only set when behind a reverse proxy
# with nginx real_ip enabled. Off by default.
TRUSTED_PROXIES=
