# Copy to .env.docker (make init does it and generates random secrets).
# Compose reads this file via --env-file (Makefile does it for you).
# Keep passwords [A-Za-z0-9] only: they are interpolated into DATABASE_URL.

HTTP_PORT=8080
APP_VERSION=latest
XDEBUG_MODE=off

MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

APP_SECRET=CHANGE_ME

# n8n (https://n8n.novotek.com.ua)
N8N_BASE_URL=https://n8n.novotek.com.ua
N8N_WEBHOOK_SECRET=
N8N_HMAC_KEY=
N8N_API_KEY=

TURNSTILE_SECRET=
CONTACT_TO_EMAIL=

# Production only (dev uses Mailpit automatically):
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=
