# Env source-of-truth for the PORTFOLIO project.
#
# The live env file lives at the REPO ROOT as `.env` (single file for dev+prod).
# The Makefile (portfolio-docker/) `cd`s to the repo root and Compose auto-loads
# that `.env` from the working directory. Do NOT use `--env-file`.
#
# Keep passwords [A-Za-z0-9] only: they are interpolated into DATABASE_URL.
# `MAILER_DSN` and `CONTACT_TO_EMAIL` are REQUIRED in prod (see compose `:?`).

HTTP_PORT=8080
APP_VERSION=latest
XDEBUG_MODE=off

MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

APP_SECRET=CHANGE_ME

# n8n (https://n8n.novotek.com.ua)
N8N_BASE_URL=https://n8n.novotek.com.ua
N8N_WEBHOOK_SECRET=
N8N_HMAC_KEY=
N8N_API_KEY=

TURNSTILE_SECRET=
CONTACT_TO_EMAIL=

# Production only (dev uses Mailpit automatically):
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=

# --- Site identity (anonymization — CHANGE TO YOUR OWN VALUES) ---
SITE_NAME=Yaroslav Dupliak
SITE_NAME_UK=Ярослав Дупляк
CONTACT_EMAIL=info@novotek.com.ua
SITE_DOMAIN=novotek.com.ua
COMPANY_NAME=Novotek
TELEGRAM_USER=dyar74
TELEGRAM_URL=https://t.me/dyar74
LINKEDIN_SLUG=duplyak
LINKEDIN_URL=https://www.linkedin.com/in/duplyak/
GITHUB_USER=dyar74
GITHUB_URL=https://github.com/dyar74/
