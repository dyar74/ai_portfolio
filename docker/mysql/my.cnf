[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
skip-name-resolve
max_connections      = 100
innodb_buffer_pool_size = 256M
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO
slow_query_log = 1
long_query_time = 1

[client]
default-character-set = utf8mb4
